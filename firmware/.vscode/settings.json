{
    "C_Cpp.intelliSenseEngine": "disabled",
    "makefile.configureOnOpen": false,
    "memory-inspector.debugTypes": [
        "arm-debugger",
        "embedded-debug",
        "gdb",
        "mplab-core-da"
    ],
    "cmake.sourceDirectory": "${workspaceFolder}/cmake/water-meter-counter/default",
    "mplab.project.workspace.addNewSourceFiles": "Always",
    "mplab.clangd.compileCommandsDir": "${workspaceFolder}/_build/water-meter-counter/default",
    "mplab.clangd.arguments": [
        "--header-insertion=never"
    ]
}